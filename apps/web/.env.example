# Web app settings. Everything here is NEXT_PUBLIC_*: it is compiled into the browser bundle, so
# never put a secret in this file. The Nansen API key belongs to the engine only.

# Where the browser reaches the engine (REST and the /ws WebSocket).
NEXT_PUBLIC_ENGINE_URL=http://localhost:8787

# Public address of this site: absolute Open Graph image links and embed widget links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional https link to the source repository, shown on the landing page.
# NEXT_PUBLIC_REPO_URL=
