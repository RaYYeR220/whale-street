# Copy to apps/engine/.env (git-ignored). Every setting is optional.
# Without a Nansen key the engine runs REPLAY (bundled recording, or a labelled synthetic demo).

# Nansen API key; setting it switches MODE=auto to LIVE. Never commit it.
# NANSEN_API_KEY=
# Alternative: read NANSEN_API_KEY from another env file (e.g. a parent folder's .env).
# ENV_FILE=../../../.env
# auto | live | replay (auto = live iff a key is set)
# MODE=auto
# PORT=8787
# HOST=0.0.0.0
# DATA_DIR=./data
# REPLAY_FILE=./replay/session.ndjson
# 1 = record the LIVE session to DATA_DIR/sessions (input for scripts/build-replay.ts)
# RECORD=0
# Comma-separated browser origins allowed by CORS (the web app)
# CORS_ORIGINS=http://localhost:3000
# Comma-separated extra hostnames accepted on /mcp (e.g. whale-street-engine.fly.dev)
# PUBLIC_HOSTS=
# Reverse-proxy hops in front of the engine whose X-Forwarded-For is trusted (0 = none; 1 behind one proxy)
# TRUST_PROXY=0
# TARGET_COMPANIES=20
# SEASON_DAYS=7
